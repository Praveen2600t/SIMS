# Smart Inventory Intelligence System (SICMS) - Environment Variables Template
# Copy this file to .env and provide your actual values.

# Database URL: Hosted PostgreSQL (Supabase / Neon / AWS RDS / Prisma Postgres)
# Example for Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Example for local prisma dev: postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
DATABASE_URL="postgresql://user:password@localhost:5432/sicms_db?schema=public"

# Secure random string used for signing server-side JWT authentication cookies
JWT_SECRET="replace-with-a-secure-random-32-character-secret-key"

# Base URL of the deployment
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret token required to trigger automated monitoring engine via cron/external webhook
CRON_SECRET="replace-with-secure-cron-monitoring-secret"
